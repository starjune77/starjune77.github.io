{
  "name": "starjune77.github.io",
  "version": "1.0.0",
  "description": "A 2D side-scrolling platformer portfolio set in the **Rain District**, an original neon city at night. Visitors run through eight districts, or open the complete professional portfolio in **Quick View**.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --import ./tools/register-jsx.mjs tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser-check.cjs",
    "test:build": "npm run build && node tools/check-build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starjune77/starjune77.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/starjune77/starjune77.github.io/issues"
  },
  "homepage": "https://github.com/starjune77/starjune77.github.io#readme",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
